# ============================================================================
#  VARIÁVEIS DE AMBIENTE - EXEMPLO
#  Copie este arquivo para ".env" e preencha com os seus valores.
#  NUNCA versione o .env real (ele está no .gitignore).
# ============================================================================

# ----- Aplicação -----
NODE_ENV=development
PORT=3000
# URL pública do backend (usada no webhook e nas URLs assinadas). Em teste local
# use a URL do ngrok, ex: https://abcd-1234.ngrok-free.app
APP_BASE_URL=http://localhost:3000

# ----- WhatsApp Cloud API (Meta) -----
# Token de acesso do app da Meta (System User token em produção)
WHATSAPP_TOKEN=EAAG...
# phone_number_id do número de teste/produção
PHONE_NUMBER_ID=1234567890
# Token que VOCÊ define e cadastra no painel da Meta para verificar o webhook
VERIFY_TOKEN=um-token-secreto-qualquer
# Versão da API do Graph
WHATSAPP_API_VERSION=v21.0
# Segredo do app da Meta (App Dashboard > Configurações > Básico > Chave secreta).
# Opcional: se preenchido, o webhook valida a assinatura das requisições.
WHATSAPP_APP_SECRET=

# ----- Anthropic (IA) -----
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado para interpretar as mensagens e conduzir a conversa.
# Padrão: o mais capaz (Opus 4.8). Para reduzir custo num bot de alto volume,
# troque por 'claude-sonnet-5' (equilíbrio) ou 'claude-haiku-4-5' (mais barato).
ANTHROPIC_MODEL=claude-opus-4-8

# ----- Transcrição de áudio (voz do WhatsApp) — OPCIONAL -----
# O Claude não transcreve áudio. Para a IA entender mensagens de voz, use um
# serviço compatível com a API Whisper. Sem isto, áudios recebem um pedido
# educado para o cliente escrever.
# Padrão já configurado para o GROQ (barato/rápido) — basta preencher a chave
# (console.groq.com > API Keys). Para OpenAI, troque BASE_URL e MODEL abaixo.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3

# ----- Banco de dados (Supabase / PostgreSQL) -----
# String de conexão do Postgres (pooler do Supabase recomendado)
DATABASE_URL=postgresql://postgres:senha@db.xxxx.supabase.co:5432/postgres

# ----- Supabase (Storage privado + client) -----
SUPABASE_URL=https://xxxx.supabase.co
# Use a SERVICE ROLE KEY apenas no backend (nunca no front-end!)
SUPABASE_KEY=eyJhbGciOi...
# Nome do bucket PRIVADO onde ficam os documentos
SUPABASE_STORAGE_BUCKET=documentos

# ----- Segurança do painel -----
# Segredo para assinar os tokens JWT de login do painel.
# EM PRODUÇÃO é obrigatório e precisa de >= 32 caracteres aleatórios.
# Gere um forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Origens permitidas no CORS (separadas por vírgula). Vazio = reflete qualquer
# origem (só aceite isso em desenvolvimento). Em produção, ponha o domínio do
# painel, ex: https://painel.loccar.com.br
CORS_ORIGINS=

# Ligue (true) quando o app rodar atrás de proxy/CDN (Vercel, Nginx, Cloudflare):
# faz o rate limit enxergar o IP real do cliente (X-Forwarded-For).
TRUST_PROXY=false

# BYPASS de login por header x-tenant-id, só para testes com curl. É perigoso:
# só funciona com NODE_ENV=development e este valor em true. NUNCA em produção.
ALLOW_DEV_TENANT_HEADER=false

# Chave para cifrar segredos no banco (o whatsapp_token de cada locadora).
# 32 bytes em hex (64 chars). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Depois de definir, migre tokens já existentes:  npm run encrypt:tokens
# Sem esta chave, os tokens ficam em texto puro (como antes).
ENCRYPTION_KEY=

# ----- Cobrança PIX (Asaas) — OPCIONAL -----
# Sem estas variáveis o Financeiro continua funcionando com registro manual
# (dinheiro, cartão, PIX na mão); só o botão "gerar PIX" fica escondido.
# A chave sai em Asaas > Integrações > API. Comece SEMPRE pelo sandbox.
ASAAS_API_KEY=
# sandbox (testes, dinheiro fake) ou production (cobrança real)
ASAAS_ENV=sandbox

# ----- Regras de negócio -----
# Horas até a pré-reserva sem documentos expirar
PRE_RESERVATION_EXPIRY_HOURS=24
# Horas após a pré-reserva para enviar o lembrete de "envie seus documentos"
DOCUMENT_REMINDER_AFTER_HOURS=3
# Fuso padrão para cálculos de lembrete (também há tenants.timezone por locadora)
DEFAULT_TIMEZONE=America/Sao_Paulo

# ----- Lembretes (templates aprovados na Meta) e jobs agendados -----
# Nomes dos templates cadastrados e aprovados no WhatsApp Manager
REMINDER_PICKUP_TEMPLATE=lembrete_retirada
REMINDER_RETURN_TEMPLATE=lembrete_devolucao
REMINDER_TEMPLATE_LANG=pt_BR
# Avisar o DONO no WhatsApp quando uma conversa precisa dele (opcional).
# Defina o nome do template aqui e o telefone do dono com:
#   npm run set:owner-alert <telefone>
# Sem os dois, o aviso ao dono fica desligado.
OWNER_ALERT_TEMPLATE=
# Frequência dos jobs (cron). Padrões: lembretes a cada 5 min, expiração a cada 15 min
REMINDERS_CRON=*/5 * * * *
EXPIRE_CRON=*/15 * * * *
# Liga/desliga os jobs agendados (deixe false se rodar em ambiente sem WhatsApp)
ENABLE_JOBS=true
